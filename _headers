# Security headers — Cloudflare Pages format (_headers).
# On other hosts, translate these into the host's header config.
#
# script-src keeps 'unsafe-inline': each page carries a tiny inline
# bootstrap that resolves the theme before first paint. Removing it
# would require hashing that script on every page — revisit if you
# ever move to a build step.
#
# connect-src is same-origin only. If the demo form's data-endpoint
# ever points at another origin, add it there.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
